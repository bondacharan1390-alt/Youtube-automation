# ==============================================================================
# AI YOUTUBE AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# -----------------
# 1. CORE BACKEND
# -----------------
PROJECT_NAME="AI YouTube Automation Studio"
VERSION="1.0.0"
DEBUG=True
APP_ENV="development"
SECRET_KEY="replace-with-a-secure-random-32-byte-secret-for-jwt-signing"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Fernet key for encrypting stored YouTube tokens and cloud API keys at rest
# (Auto-generated if left blank)
FERNET_KEY=""
DATABASE_URL="sqlite:///./youtube_studio.db"

# -----------------
# 2. LOCAL AI ENGINES (Zero-cost, low-footprint Windows 11 setup)
# -----------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b-instruct-q4_K_M"

COMFYUI_BASE_URL="http://localhost:8188"
COMFYUI_CHECKPOINT="v1-5-pruned-emaonly.safetensors"

# Kokoro & faster-whisper run locally via Python bindings without external daemons
KOKORO_VOICE="af_heart"
WHISPER_MODEL="base"

# -----------------
# 3. CLOUD AI PROVIDERS (Optional fallbacks - Never hardcode real keys)
# -----------------
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""

# -----------------
# 4. YOUTUBE API & GOOGLE OAUTH 2.0
# -----------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# -----------------
# 5. FRONTEND
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# -----------------
# 6. OPTIONAL N8N AUTOMATION CONNECTOR
# -----------------
N8N_ENABLED="false"
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# -----------------
# 7. HIGGSFIELD AI (server-side API configuration only)
# -----------------
HIGGSFIELD_API_BASE_URL="https://api.higgsfield.ai"
HIGGSFIELD_TIMEOUT_SECONDS="30"
HIGGSFIELD_POLL_INTERVAL_SECONDS="2"
HIGGSFIELD_MAX_POLL_SECONDS="600"
